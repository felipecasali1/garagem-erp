# Server-only Supabase credentials (SUPABASE_SERVICE_KEY must never use the VITE_ prefix).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=

# Public values are embedded in browser assets at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Node production server settings.
HOST=0.0.0.0
PORT=3000
