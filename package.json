{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "prestart": "node scripts/check-node-version.mjs",
    "dev": "vite dev",
    "build": "node --env-file-if-exists=.env scripts/check-build-env.mjs && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:verify-user": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/verify-local-user.mjs",
    "supabase:start": "node scripts/ensure-supabase-local-network.mjs && supabase start --network-id garagem-erp-local",
    "supabase:stop": "supabase stop --network-id garagem-erp-local",
    "supabase:env": "supabase status --output env --network-id garagem-erp-local",
    "supabase:test": "supabase test db --local --network-id garagem-erp-local",
    "smoke:production": "npm run build && node --env-file-if-exists=.env tests/smoke/production-runtime.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test:unit": "tsc -p tsconfig.tests.json && node --test .test-dist/tests/unit/*.test.js tests/unit/local-setup.test.mjs",
    "test:integration": "tsc -p tsconfig.tests.json && node --test .test-dist/tests/integration/*.test.js",
    "test": "tsc -p tsconfig.tests.json && node --test .test-dist/tests/unit/*.test.js tests/unit/local-setup.test.mjs .test-dist/tests/integration/*.test.js"
  },
  "dependencies": {
