# Copy to .env.docker and replace these placeholders before running the image.
# Keep this file separate from the development .env used by `npm run dev`.

# URL used by server-side application code; in Compose this can be an internal URL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
SUPABASE_SERVICE_KEY=replace-with-server-only-service-role-key

# Public values delivered to the browser at container runtime.
# The URL must be reachable from the browser; it can differ from SUPABASE_URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key

HOST=0.0.0.0
PORT=3000
